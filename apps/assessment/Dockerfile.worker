# Separate image/process from the API -- the expiry sweeper polls Postgres on
# its own interval and shouldn't share a container with request handling.
# Build with: docker build -f apps/assessment/Dockerfile.worker -t quiz-assessment-worker .
FROM node:22-alpine

RUN npm install -g pnpm@10.12.3

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps/assessment ./apps/assessment

RUN pnpm install --frozen-lockfile
RUN pnpm --filter assessment-svc prisma:generate

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "assessment-svc", "worker:start"]
