{
  "name": "assessment-svc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "worker:start": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured for this service yet)\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.10.1",
    "@quiz/contracts": "workspace:*",
    "@quiz/kafka-kit": "workspace:*",
    "@quiz/observability": "workspace:*",
    "@quiz/redis-kit": "workspace:*",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
