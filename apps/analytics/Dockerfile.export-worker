# Separate process from the API and the rollup consumer -- a multi-minute CSV
# streaming job has a different resource/restart profile than either.
# Build with: docker build -f apps/analytics/Dockerfile.export-worker -t quiz-analytics-export-worker .
FROM node:22-alpine

RUN npm install -g pnpm@10.12.3

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps/analytics ./apps/analytics

RUN pnpm install --frozen-lockfile
RUN pnpm --filter analytics-svc prisma:generate

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "analytics-svc", "export-worker:start"]
