# Separate process from the API -- a Kafka consumer group member shouldn't
# share a container (or crash/restart lifecycle) with request handling.
# Build with: docker build -f apps/analytics/Dockerfile.rollup-consumer -t quiz-analytics-rollup-consumer .
FROM node:22-alpine

RUN npm install -g pnpm@10.12.3

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps/analytics ./apps/analytics

RUN pnpm install --frozen-lockfile
RUN pnpm --filter analytics-svc prisma:generate

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "analytics-svc", "rollup-consumer:start"]
