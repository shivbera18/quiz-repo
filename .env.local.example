# Local dev — choose ONE mode and copy to .env.local
#   Hybrid (recommended): pnpm dev — infra in Docker, apps natively (tsx watch)
#   Cloud-free: pnpm dev:local — no Docker, single Neon/Supabase URL + in-memory mocks
# See README.md "Local Development" and HOSTING.md

# ── Hybrid (recommended): Local Docker Postgres (host port 5433) ──
# This is what pnpm dev uses — infra (postgres/redis/redpanda/minio) stays in Docker,
# apps + workers run natively. Keeps existing postgres-data volume, full functionality.
# DATABASE_URL="postgresql://quiz_admin:quiz_admin_pw@localhost:5433/quiz"
# KAFKA_BROKERS="localhost:19092"
# REDIS_URL="redis://localhost:6380"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# EXPORT_BUCKET="quiz-exports"
# GATEWAY_URL="http://localhost:4000"

# ── Cloud-free alternative: Single Neon/Supabase URL (no Docker) ──
# Get one free at https://neon.tech or https://supabase.com
# The app auto-appends ?schema=<service> per service via ensureDatabaseUrl()
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: per-service overrides if you want separate DBs
# IDENTITY_DATABASE_URL="postgresql://.../db?schema=identity&sslmode=require"
# CATALOG_DATABASE_URL="postgresql://.../db?schema=catalog&sslmode=require"
# ASSESSMENT_DATABASE_URL="postgresql://.../db?schema=assessment&sslmode=require"
# ANALYTICS_DATABASE_URL="postgresql://.../db?schema=analytics&sslmode=require"
# NOTIFICATION_DATABASE_URL="postgresql://.../db?schema=notification&sslmode=require"

# Disable heavy infra only for cloud-free mode (pnpm dev:local sets these)
# For hybrid (pnpm dev), leave these false/unset so Kafka/Redis/S3 stay real.
DISABLE_KAFKA=true
DISABLE_REDIS=true
DISABLE_S3=true

# If you DO want Redis/Kafka locally without Docker, unset the above and set:
# REDIS_URL="redis://localhost:6379"
# KAFKA_BROKERS="localhost:9092"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"

# Gateway (where Next.js forwards)
GATEWAY_URL="http://localhost:4000"

# Optional AI (Gemini) - same key is used by catalog-svc and web
GEMINI_API_KEY=""

# Optional push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"
