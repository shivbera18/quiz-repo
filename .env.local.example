# Docker-free local dev (pnpm dev:local) - copy to .env.local and fill in
# See HOSTING.md "Local dev without Docker" or run: cp .env.local.example .env.local

# Single Neon/Supabase Postgres URL - the app will auto-append ?schema=<service> per service
# Get one free at https://neon.tech or https://supabase.com
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: per-service overrides if you want separate DBs
# IDENTITY_DATABASE_URL="postgresql://.../db?schema=identity&sslmode=require"
# CATALOG_DATABASE_URL="postgresql://.../db?schema=catalog&sslmode=require"
# ASSESSMENT_DATABASE_URL="postgresql://.../db?schema=assessment&sslmode=require"
# ANALYTICS_DATABASE_URL="postgresql://.../db?schema=analytics&sslmode=require"
# NOTIFICATION_DATABASE_URL="postgresql://.../db?schema=notification&sslmode=require"

# Docker-free flags - disable heavy infra (auto-set by `pnpm dev:local`, or set here)
DISABLE_KAFKA=true
DISABLE_REDIS=true
DISABLE_S3=true

# If you DO want Redis/Kafka locally without Docker, unset the above and set:
# REDIS_URL="redis://localhost:6379"
# KAFKA_BROKERS="localhost:9092"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"

# Gateway (where Next.js forwards)
GATEWAY_URL="http://localhost:4000"

# Optional AI (Gemini) - same key is used by catalog-svc and web
GEMINI_API_KEY=""

# Optional push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"
