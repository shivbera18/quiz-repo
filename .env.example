# Copy this file to .env.local for local development (Next.js loads .env.local
# automatically and it's gitignored). See HOSTING.md for the full setup guide.

# PostgreSQL connection string. Works with a local Postgres instance or a
# managed provider (Neon, Supabase, Railway, RDS, ...).
# Local example:      postgresql://postgres:postgres@localhost:5432/quizdb
# Neon (pooled) example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/quizdb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quizdb"

# Used by the login/signup routes' opaque token scheme. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Google Gemini API key, used by the AI quiz/question/flashcard generation
# routes. Get a free key at https://aistudio.google.com/apikey. Optional --
# those routes degrade to an error (or a local fallback, for flashcards)
# without it.
GEMINI_API_KEY=""

# Web Push (VAPID) keys, used for browser push notifications. Generate a pair
# with: npx web-push generate-vapid-keys
# Known issue: the server-side sender currently reads VAPID_PUBLIC_KEY, but
# only NEXT_PUBLIC_VAPID_PUBLIC_KEY is set below -- until that's fixed, push
# sends silently no-op. See HOSTING.md's "Known gaps" section.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="you@example.com"

# Set automatically by most hosts (Vercel, etc.) -- only set this yourself for
# local production-mode testing (`next start`).
# NODE_ENV="production"
