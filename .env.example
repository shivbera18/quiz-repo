# This file is for the two things that still read env vars from the repo
# root: apps/web (Next.js, when run outside Docker via `pnpm --filter web
# dev`) and ad-hoc local tooling. It is NOT what configures the Docker
# Compose stack -- that's infra/docker-compose.yml (dev credentials are
# inlined there per-service) plus an optional infra/.env for the three
# secrets below. See HOSTING.md for the full setup guide.

# apps/web's own server-side route handlers (app/api/**) forward every
# request to the gateway rather than touching a database directly -- see
# apps/web/lib/gateway-client.ts. This is the only address they need.
GATEWAY_URL="http://localhost:4000"

# Google Gemini API key. Used directly by the two AI routes apps/web still
# owns (api/ai/generate-questions, api/generate-flashcards -- both stateless,
# no DB access, which is why they weren't moved into catalog-svc). Optional --
# those routes degrade to an error (or a local fallback, for flashcards)
# without it. catalog-svc's own AI quiz generation needs its own copy of this
# key set in infra/.env (see HOSTING.md Part 2) -- it does not read this file.
GEMINI_API_KEY=""

# Browser-visible half of the VAPID pair used for push subscription. It must
# match VAPID_PUBLIC_KEY in infra/.env. Empty disables browser subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Set automatically by most hosts -- only set this yourself for local
# production-mode testing (`next start`).
# NODE_ENV="production"
