# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# turborepo build cache -- large binary archives, machine-local, never useful to commit
.turbo/

# Claude Code local settings (permissions/session config, not project source)
.claude/settings.local.json

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files -- blanket pattern with explicit exceptions, not a growing
# list of specific filenames. The previous version missed .env.production
# specifically, which had a live Neon DB password committed to history as a
# result; a real secret leak this pattern change is meant to make structurally
# impossible instead of one exception line away from happening again.
.env*
!.env.example
!.env.production.example
!infra/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database files (SENSITIVE - DO NOT COMMIT)
prisma/dev.db*
prisma/*.db*
*.db
*.db-journal
*.sqlite
*.sqlite3

# backup data (SENSITIVE - contains user data)
# NOTE: this used to be a blanket `*.json` ignore with per-file exceptions, which
# silently dropped .eslintrc.json from version control for this repo's entire
# history (it matched the pattern and had no exception). Replaced with what the
# comment actually describes protecting against -- data exports -- so new
# legitimate config files (turbo.json, per-package package.json/tsconfig.json,
# etc.) don't need a new exception line added every time one is created.
backup-data/
*.export.json
*-export.json

# database schema backups
prisma/schema.*.backup
prisma/schema.local.prisma

# test and debug files
test-*.js
debug-*.js
check-*.js
seed-*.js
setup-*.js
import-data.js
export-production-data.js
switch-database.js
clear-quiz-db.js
inject-test-data.js

# test data files
*.test.json
test-admin-analytics-data.json

# deployment scripts (may contain sensitive info)
setup-production-db.bat
setup-production-db.sh

# generated files (Prisma clients, wherever a service's schema.prisma points them)
**/generated/prisma/
**/lib/generated/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# logs
logs
*.log

# runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Database files and sensitive data
*.db
*.db-*
prisma/dev.db*
backup-data/
