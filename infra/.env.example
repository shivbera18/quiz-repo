# Copy to infra/.env (gitignored) to override any of docker-compose.yml's
# dev-only defaults. Compose auto-loads infra/.env because it sits next to
# infra/docker-compose.yml -- nothing here needs passing on the command line.
# Every var below is optional; omitting one just keeps the matching dev
# default. For anything beyond your own machine, set all of the password
# fields to real random values -- generate each with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Postgres superuser + one password per service role. These MUST match
# between first-boot (infra/postgres/init/01-schemas-roles.sh reads the same
# names) and every service's DATABASE_URL -- docker-compose.yml already wires
# that up for you as long as you set them here, not by hand-editing the
# compose file.
POSTGRES_ADMIN_PASSWORD=
IDENTITY_RW_PASSWORD=
CATALOG_RW_PASSWORD=
ASSESSMENT_RW_PASSWORD=
ANALYTICS_RW_PASSWORD=
NOTIFICATION_RW_PASSWORD=

# MinIO (S3-compatible) root credentials, used by analytics-svc's export
# worker and its presigned-download-URL generation.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional features -- omit to leave AI generation / push notifications
# disabled rather than erroring.
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
