{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["GATEWAY_URL", "DATABASE_URL", "DISABLE_KAFKA", "DISABLE_REDIS", "DISABLE_S3", "KAFKA_BROKERS", "REDIS_URL", "S3_ENDPOINT", "GEMINI_API_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "prisma:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/prisma/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
