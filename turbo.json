{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["GATEWAY_URL", "DATABASE_URL", "DISABLE_KAFKA", "DISABLE_REDIS", "DISABLE_S3", "KAFKA_BROKERS", "REDIS_URL", "S3_ENDPOINT", "S3_REGION", "S3_ACCESS_KEY", "S3_SECRET_KEY", "EXPORT_BUCKET", "MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD", "GEMINI_API_KEY", "JWT_SECRET", "VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_EMAIL", "NEXT_PUBLIC_VAPID_PUBLIC_KEY", "PORT", "IDENTITY_SVC_URL", "CATALOG_SVC_URL", "ASSESSMENT_SVC_URL", "ANALYTICS_SVC_URL", "NOTIFICATION_SVC_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "prisma:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/prisma/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "worker:dev": {
      "cache": false,
      "persistent": true
    },
    "rollup-consumer:dev": {
      "cache": false,
      "persistent": true
    },
    "export-worker:dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
